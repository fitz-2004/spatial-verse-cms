---
import AposArea from '@apostrophecms/apostrophe-astro/components/AposArea.astro';
import HomeRichTextWidget from './HomeRichTextWidget.astro';

const { widget } = Astro.props;
const metrics = Array.isArray(widget.metrics) ? widget.metrics : [];
---

<section id="why" class="why-section" aria-labelledby="why-title">
  <div class="content-width why-layout" data-reveal="why-layout">
    <div class="why-copy">
      <AposArea area={widget.eyebrow} widgetComponent={HomeRichTextWidget} contentClass="section-index" aposStyle="display: contents" />
      <AposArea area={widget.heading} widgetComponent={HomeRichTextWidget} contentId="why-title" aposStyle="display: contents" />
      <AposArea area={widget.description} widgetComponent={HomeRichTextWidget} aposStyle="display: contents" />
      <a class="button button-ghost" href={widget.linkHref}>{widget.linkLabel} <span aria-hidden="true">↗</span></a>
    </div>
    <div class="metric-grid" aria-label="平台数据指标">
      {metrics.map((metric) => (
        <div class="metric">
          {metric.value?.items
            ? <AposArea
                area={metric.value}
                widgetComponent={HomeRichTextWidget}
                contentClass="metric-value"
                aposClassName="metric-value-area"
                aposStyle="display: contents"
              />
            : <strong>{metric.value}</strong>}
          <span>{metric.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
