---
import AposArea from '@apostrophecms/apostrophe-astro/components/AposArea.astro';
import AboutRichTextWidget from './AboutRichTextWidget.astro';
const { widget } = Astro.props;
---
<section class="about-hero" aria-labelledby="about-title"><div class="about-grid" aria-hidden="true"></div><div class="about-scan about-scan-one" aria-hidden="true"></div><div class="about-scan about-scan-two" aria-hidden="true"></div><div class="content-width about-hero-layout"><div class="about-hero-copy"><div class="about-editable"><AposArea area={widget.eyebrow} widgetComponent={AboutRichTextWidget} contentClass="section-index" aposStyle="display: contents" /></div><div class="about-editable"><AposArea area={widget.heading} widgetComponent={AboutRichTextWidget} contentId="about-title" aposStyle="display: contents" /></div><div class="about-editable"><AposArea area={widget.lead} widgetComponent={AboutRichTextWidget} contentClass="about-hero-lead" aposStyle="display: contents" /></div><a class="button button-primary" href={widget.ctaHref || '#contact-drawer'}><div class="about-editable about-editable--inline"><AposArea area={widget.cta} widgetComponent={AboutRichTextWidget} aposStyle="display: contents" /></div><span aria-hidden="true">↗</span></a></div><div class="about-orbit-scene" aria-label="群核空间智能平台数据核心"><div class="about-orbit about-orbit-outer" aria-hidden="true"></div><div class="about-orbit about-orbit-middle" aria-hidden="true"></div><div class="about-orbit about-orbit-inner" aria-hidden="true"></div><span class="about-orbit-node about-node-one">DATA</span><span class="about-orbit-node about-node-two">AI</span><span class="about-orbit-node about-node-three">3D</span><div class="about-core-mark"><span>SPATIAL</span><strong>CORE</strong><small>06 / ABOUT</small></div></div></div><div class="content-width about-hero-footer"><span>ABOUT SYSTEM / ONLINE</span><span>SCROLL TO EXPLORE</span></div></section>
