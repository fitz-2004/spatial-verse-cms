---
import AposArea from '@apostrophecms/apostrophe-astro/components/AposArea.astro'; import AboutRichTextWidget from './AboutRichTextWidget.astro'; const { widget } = Astro.props;
---
<section class="about-quote section" aria-labelledby="about-quote-title"><div class="content-width about-quote-layout"><div class="about-editable"><AposArea area={widget.eyebrow} widgetComponent={AboutRichTextWidget} contentClass="section-index" aposStyle="display: contents" /></div><figure><div class="about-editable"><AposArea area={widget.quote} widgetComponent={AboutRichTextWidget} contentId="about-quote-title" aposStyle="display: contents" /></div><figcaption><div class="about-editable about-editable--inline"><AposArea area={widget.name} widgetComponent={AboutRichTextWidget} aposStyle="display: contents" /></div><div class="about-editable about-editable--inline"><AposArea area={widget.organization} widgetComponent={AboutRichTextWidget} aposStyle="display: contents" /></div></figcaption></figure></div></section>
