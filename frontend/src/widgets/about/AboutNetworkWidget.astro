---
import AposArea from '@apostrophecms/apostrophe-astro/components/AposArea.astro'; import AboutRichTextWidget from './AboutRichTextWidget.astro';
const { widget } = Astro.props; const portals = Array.isArray(widget.portals) ? widget.portals : [];
---
<section class="about-network section" aria-labelledby="about-network-title"><div class="content-width"><div class="about-section-heading"><div class="about-editable"><AposArea area={widget.eyebrow} widgetComponent={AboutRichTextWidget} contentClass="section-index" aposStyle="display: contents" /></div><div class="about-editable"><AposArea area={widget.heading} widgetComponent={AboutRichTextWidget} contentId="about-network-title" aposStyle="display: contents" /></div></div><div class="about-network-layout"><div class="about-network-rail" aria-hidden="true"><span class="about-rail-line"></span><span class="about-rail-line about-rail-line-two"></span><span class="about-rail-pulse"></span><strong>QH / 2018 — NOW</strong></div><div class="about-network-copy"><div class="about-editable"><AposArea area={widget.body} widgetComponent={AboutRichTextWidget} aposStyle="display: contents" /></div><div class="about-portal-grid">{portals.map((item) => <a class="about-portal-link" href={item.href}><span>{item.number}</span><strong>{item.label}</strong><span>↗</span></a>)}</div></div></div></div></section>
