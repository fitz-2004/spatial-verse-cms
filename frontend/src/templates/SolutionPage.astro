---
import '../styles/solution.css';
import SolutionHero from '../components/solution/SolutionHero.astro';
import SolutionVideoSection from '../components/solution/SolutionVideoSection.astro';
import SolutionChallenges from '../components/solution/SolutionChallenges.astro';
import SolutionAdvantages from '../components/solution/SolutionAdvantages.astro';
import SolutionServices from '../components/solution/SolutionServices.astro';
import SolutionCTA from '../components/solution/SolutionCTA.astro';

const { page, locale } = Astro.props.aposData;
const isEnglish = String(locale || page?.aposLocale || 'zh').split(':')[0] === 'en';
const accent = page.accent || '#29f5d1';
---

<div class="solution-detail-page" style={`--detail-accent: ${accent};`}>
  <SolutionHero
    title={page.title}
    englishTitle={page.englishTitle}
    heroTitle={page.heroTitle}
    heroLead={page.heroLead}
    sequence={page.sequence}
    accent={accent}
    primaryActionLabel={isEnglish ? 'Start a Conversation' : '开始沟通'}
    secondaryActionLabel={isEnglish ? 'Download Dataset' : '免费下载数据集'}
  />

  <SolutionVideoSection
    title={page.title}
    englishTitle={page.englishTitle}
    media={page.media}
    videoDescription={page.videoDescription}
  />

  <SolutionChallenges
    challengeTitle={page.challengeTitle}
    challenges={page.challenges || []}
  />

  <SolutionAdvantages
    advantageTitle={page.advantageTitle}
    advantages={page.advantages || []}
  />

  <SolutionServices
    serviceTitle={page.serviceTitle}
    services={page.services || []}
  />

  <SolutionCTA
    ctaTitle={page.ctaTitle || (isEnglish ? 'Bring the Next Dataset into Real Applications.' : '让下一组数据进入真实应用。')}
    ctaLabel={isEnglish ? 'Contact Us' : '联系我们'}
  />
</div>

<script is:inline>
  (() => {
    const cards = Array.from(document.querySelectorAll('[data-scroll-card]'));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reducedMotion || !('IntersectionObserver' in window)) {
      cards.forEach((card) => card.classList.add('is-in-view'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) =>
          entry.target.classList.toggle('is-in-view', entry.isIntersecting)
        );
      },
      { threshold: 0.16, rootMargin: '-10% 0px -12% 0px' }
    );

    cards.forEach((card) => observer.observe(card));
  })();
</script>
