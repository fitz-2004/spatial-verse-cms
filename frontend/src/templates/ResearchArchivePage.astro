---
import AposArea from '@apostrophecms/apostrophe-astro/components/AposArea.astro';
import { paths } from '../lib/siteChrome.js';
import '../styles/research.css';

const { page } = Astro.props.aposData;
const intro = page?.intro || {};
const sectionHead = page?.sectionHead || {};
const signals = Array.isArray(intro?.signals) ? intro.signals : [];
const papers = Array.isArray(page?._papers) ? page._papers : [];
const coreLinks = [
  { number: '01', label: '核心能力', href: paths.core[0] },
  { number: '03', label: '样例数据集', href: paths.core[2] }
];
---

<section class="section-capabilities-intro core-page-intro archive-hero" aria-labelledby="research-title">
  <div class="content-width">
    <div class="section-intro">
      <p class="section-index">{intro?.eyebrow || '03 / RESEARCH ARCHIVE'}</p>
      <div>
        <h1 id="research-title">{intro?.title || '学术研究'}</h1>
        <p>{intro?.lead || ''}</p>
        <div class="core-page-signal-row">
          {signals.map((signal) => <span key={signal.label}>{signal.label}</span>)}
        </div>
      </div>
    </div>
  </div>
  <div class="core-page-intro-grid" aria-hidden="true" />
  <div class="core-page-intro-orbit" aria-hidden="true" />
</section>

<section class="research-archive-section section" aria-labelledby="research-archive-title">
  <div class="content-width">
    <div class="archive-section-head">
      <p class="section-index">{sectionHead?.index || 'RESEARCH ARCHIVE / 2018—NOW'}</p>
      <h2 id="research-archive-title">{sectionHead?.heading || '从空间数据到智能系统'}</h2>
    </div>
    <div class="research-archive-list">
      {papers.map((paper) => (
        <article class="research-archive-item" key={paper._id}>
          <span class="research-archive-year">{paper.year}</span>
          <div>
            <p class="research-archive-venue">{paper.venue}</p>
            <h3>{paper.title}</h3>
            <p>{paper.abstract}</p>
          </div>
          <a href={paper.externalUrl} target="_blank" rel="noreferrer" aria-label={`查看 ${paper.title}`}>↗</a>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="core-page-next content-width" aria-label="核心页面导航">
  <div><span>RESEARCH ARCHIVE / COMPLETE</span><strong>返回核心能力，继续探索群核的数据基础设施</strong></div>
  <div class="core-page-next-links">
    {coreLinks.map((item, index) => (
      <a href={item.href} key={item.href}><span>{item.number}</span>{item.label}<b>↗</b></a>
    ))}
  </div>
</section>