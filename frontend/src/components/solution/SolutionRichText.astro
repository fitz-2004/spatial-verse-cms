---
import AposArea from '@apostrophecms/apostrophe-astro/components/AposArea.astro';

// Unified rich text renderer for solution pages.
// Accepts either a plain string (mock data / fallback) or an Apostrophe
// area object (CMS data). Area objects render via <AposArea>, which enables
// in-context editing when the editor is logged in. An empty area falls back
// to the `fallback` prop so pages always show the original-site copy.
const { content, className, fallback = '' } = Astro.props;

const isArea = content && typeof content === 'object' && content.metaType === 'area' && Array.isArray(content.items);
const hasItems = isArea && content.items.length > 0;
const text = typeof content === 'string' ? content : fallback;
---

{hasItems ? (
  <AposArea area={content} aposClassName={className || ''} />
) : text ? (
  <span class={className || ''} set:html={text} />
) : null}
