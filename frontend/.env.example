# Astro Frontend Environment Variables
# Copy this file to .env and fill in your values.

# Required for local development — must match APOS_EXTERNAL_FRONT_KEY in the backend .env.
APOS_EXTERNAL_FRONT_KEY=dev

# ApostropheCMS backend origin. In production, use the Render service URL
# without a trailing slash.
APOS_HOST=http://localhost:3000

# Public production origin used for canonical, Open Graph and JSON-LD URLs.
# Never include a trailing slash. Local development falls back to the request origin.
# PUBLIC_SITE_URL=https://www.example.com

# Port for the Astro dev/preview server (default: 4321).
# PORT=4321
